# Secrets — API keys live here. Never commit these.
data/settings.json
.env

# Local data: your tracker database, gathered postings, logs, exports.
# feeds.json is your subscription list, not a shipped default — the app seeds
# DEFAULT_FEEDS when it's absent.
data/feeds.json
data/tracker.db
data/tracker.db-wal
data/tracker.db-shm
data/logs/
data/exports/

# Queue state and agy scratch. Operational, not the user's record — safe to
# delete wholesale, and swept at startup.
data/queue.db
data/queue.db-wal
data/queue.db-shm
data/jobs/
data/agy.lock
data/agy.lock.owner

# Control plane: provisioned per-user instances, exports, soft-deleted
# accounts. Other people's career records live here — never commit it.
.facet-host/

# Your actual career record and anything cut from it.
workspace/profile.json
workspace/master_resume.md
workspace/job_description.md
workspace/tailored_fields.json

# Per-machine tool settings — holds absolute paths from whoever ran it.
# Shared .claude/settings.json (if ever added) is intentionally NOT ignored.
.claude/settings.local.json
.claude-flow/

# Environments and build output
backend/.venv/
__pycache__/
*.py[cod]
node_modules/
.next/
*.tsbuildinfo

# OS noise
.DS_Store
Thumbs.db
