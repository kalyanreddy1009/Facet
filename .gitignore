# Secrets — API keys live here. Never commit these.
data/settings.json
.env

# Local data: your tracker database, gathered postings, logs, exports.
# feeds.json is your subscription list, not a shipped default — the app seeds
# DEFAULT_FEEDS when it's absent.
data/feeds.json
data/tracker.db
# Per-user homes. A pattern, not a list: users are created at runtime, so
# naming their files individually guarantees the next one gets committed.
data/users/
workspace/users/
data/tracker.db-wal
data/tracker.db-shm
data/logs/
data/exports/

# Queue state and agy scratch. Operational, not the user's record — safe to
# delete wholesale, and swept at startup.
data/queue.db
data/queue.db-wal
data/queue.db-shm
data/jobs/
data/agy.lock
data/agy.lock.owner

# Control plane: provisioned per-user instances, exports, soft-deleted
# accounts. Other people's career records live here — never commit it.
.facet-host/

# Your actual career record and anything cut from it.
workspace/profile.json
workspace/master_resume.md
workspace/job_description.md
workspace/tailored_fields.json

# Per-machine tool settings — holds absolute paths from whoever ran it.
# Shared .claude/settings.json (if ever added) is intentionally NOT ignored.
.claude/settings.local.json
.claude-flow/

# Environments and build output
backend/.venv/
__pycache__/
*.py[cod]
node_modules/
.next/
# The alternate build directories. `deploy/publish.sh` builds into
# .next.incoming and swaps it in so the running server's own files are never
# deleted underneath it, keeping .next.previous as the rollback; the others are
# scratch roots used to build or serve a sandbox without touching the live one.
.next.incoming/
.next.previous/
.next.qa/
.next.build/
*.tsbuildinfo

# Scratch inputs and outputs from manual testing — real resumes go through the
# app, not the repo.
backend/resume_*.pdf
backend/resume_*.docx
workspace/dummy_*.txt

# Working briefs handed to the assistant. Inputs to the work, not part of it.
*.docx
prompt.txt

# ...except the resume template shells, which are part of the product rather
# than an input to it. Without this the seven Word templates are absent from a
# fresh clone, `render_resume_docx` silently falls back to the legacy shell for
# every template, and the Education bug that shell carries comes back with it.
!templates/resumes/*.docx
!templates/resume_template.docx

# OS noise
.DS_Store
Thumbs.db
