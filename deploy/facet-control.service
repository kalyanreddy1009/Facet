# The control plane: admin portal, provisioning, retention, backups.
#
#   sudo cp deploy/facet-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now facet-control
#
# Native, like the per-user backends, and for the same reason: it manages the
# host. It is also the only process here that touches the Docker socket.

[Unit]
Description=Facet control plane
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=facet
Group=facet
WorkingDirectory=/opt/facet/backend

Environment=FACET_HOST_ROOT=/srv/facet
Environment=FACET_BASE_DOMAIN=facet.example
Environment=FACET_TUNNEL_CONFIG=/etc/cloudflared/config.yml
# Environment=FACET_TUNNEL_ID=<your-tunnel-id>
#
# Cloudflare API automation is opt-in (PLAN.md D8) — a token with
# Access-write is a real capability. Left unset, provisioning prints the
# exact steps to click instead.
# Environment=CF_ACCOUNT_ID=...
# Environment=CF_API_TOKEN=...

# Binds 127.0.0.1 only. cloudflared reaches it over the loopback and a
# one-email Access policy is the authentication; publishing this port would
# bypass both.
ExecStart=/opt/facet/backend/.venv/bin/python -m control.app

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# /srv/facet: user instances, exports, backups.
# /etc/cloudflared: the ingress file, regenerated from the user table.
ReadWritePaths=/srv/facet /etc/cloudflared

[Install]
WantedBy=multi-user.target
