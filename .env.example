# Copy to `.env` next to docker-compose.yml and edit. Every value is
# optional — `docker compose up --build` works with none of them set.
#
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows)

# ---------------------------------------------------------------- ports
# Change these if 3000 or 8000 are taken on your machine. Only the host side
# moves; the containers always listen on 3000/8000 internally.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ------------------------------------------------------- job source keys
# Optional. Without them the keyless providers (RemoteOK, Arbeitnow, Jobicy,
# Himalayas) and your RSS feeds still work. See README → "Where postings
# come from".
#
# Jooble is the one that reaches LinkedIn / Indeed / Naukri listings.
JOOBLE_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ------------------------------------------------------------------- agy
# The AI features (tailoring, profile extraction) shell out to the `agy`
# CLI. Everything else — job search, filters, the Cabinet, /status — works
# without it, and /status reports it as unavailable rather than failing
# obscurely.
#
# A container cannot call a CLI installed on your host. To use agy in Docker
# you need it INSIDE the image, which means two things:
#
#   1. Install it. Add a layer to backend/Dockerfile that installs the Linux
#      build of Antigravity, e.g.:
#          RUN curl -fsSL <install-url> | sh
#      Set FACET_AGY_BIN below if it doesn't land on PATH.
#
#   2. Give it credentials. Authenticate once on your host, then point
#      AGY_CONFIG_DIR at the directory holding that login so the container
#      mounts it. Use an ABSOLUTE path — compose does not expand `~`:
#          Linux / macOS:  /home/you/.gemini
#          Windows:        C:/Users/You/.gemini      (forward slashes)
#      Leave it unset and a throwaway volume is used instead, which is the
#      right choice if you aren't using agy.
#
# Whether a host login is portable to another machine depends on Antigravity,
# not on Facet — if the token is device-bound you'll need to authenticate
# inside the container instead.
AGY_CONFIG_DIR=
FACET_AGY_BIN=agy
FACET_AGY_MODEL=gemini-3.1-pro-high
FACET_AGY_TIMEOUT=300

# ------------------------------------------------------------------ CORS
# Only consulted if you call the backend directly instead of through the
# frontend's /api proxy. Comma-separated.
FACET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
